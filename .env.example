# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/chess_db?schema=public"

# NextAuth / Auth.js Configuration
# ─────────────────────────────────
# For local development:
#   NEXTAUTH_URL="http://localhost:3000"
#
# For Vercel production (https://chess-wine-delta.vercel.app):
#   On Vercel, NEXTAUTH_URL / AUTH_URL are auto-detected from incoming
#   requests when AUTH_TRUST_HOST=true, so you usually do NOT need to set them.
#   If you still want to be explicit:
#     NEXTAUTH_URL="https://chess-wine-delta.vercel.app"
#     AUTH_URL="https://chess-wine-delta.vercel.app"

NEXTAUTH_SECRET="generate-strong-random-secret-using-openssl-rand-base64-32"
AUTH_SECRET="generate-strong-random-secret-using-openssl-rand-base64-32"

# Google OAuth 2.0 Credentials (from Google Cloud Console)
# ─────────────────────────────────
# In the Google Cloud Console → APIs & Services → Credentials, configure:
#
#   Authorized JavaScript origins:
#     - http://localhost:3000                         (for local dev)
#     - https://chess-wine-delta.vercel.app           (for production)
#
#   Authorized redirect URIs:
#     - http://localhost:3000/api/auth/callback/google          (for local dev)
#     - https://chess-wine-delta.vercel.app/api/auth/callback/google  (for production)
#
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
